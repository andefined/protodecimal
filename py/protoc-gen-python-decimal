#!/usr/bin/env python3
"""Runs the protodecimal plugin straight from the repo, without pip install.

The implementation lives in protodecimal/plugin.py; installing the package
(pip install .) also puts `protoc-gen-python-decimal` on PATH as a
console script, which protoc/buf can then use without this wrapper.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from protodecimal.plugin import main

if __name__ == "__main__":
    main()
